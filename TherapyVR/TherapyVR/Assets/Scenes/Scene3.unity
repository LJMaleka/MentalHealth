  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: " Welcome. I'm glad you're here today.\r\n\r\n This room is a safe space
    where people come together to share their journeys \u2014 not to\r\n judge, not
    to compare, but to remind each other that change is possible.\r\n\r\n Around
    you, you'll meet six people who've walked through their own struggles \u2014
    anxiety,\r\n depression, financial distress, substance abuse, the work of taking
    accountability after\r\n causing harm, and the ongoing process of personal growth.
    Each of them has faced\r\n something difficult, and each of them found their
    way forward with support, honesty, and\r\n the right guidance.\r\n\r\n Feel free
    to approach anyone whose story speaks to you. Click on their board to hear a\r\n
    little about their journey, and if you'd like to go deeper, they'll share more.\r\n\r\n
    There's no right way to do this. Take your time. When you're ready, we'll begin."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 60f5e526888f0764988b3c21041e9c2b, type: 2}
